{
  "kind": "youtube",
  "version": "0.1.0",
  "title": "YouTube",
  "description": "Search videos, read details and manage playlists and uploads on YouTube.",
  "repository_url": "https://github.com/HackInvent/bloxmith-youtube",
  "bloxsmith_compatibility": [
    "1.0.9"
  ],
  "tested_with_bloxsmith": "1.0.9",
  "prerequisites": [
    {
      "type": "manual",
      "name": "Linux/POSIX with Python 3.10+ and TLS support, a YouTube Data API v3 key and/or a Google OAuth grant with a YouTube scope stored in the BloxSmith wallet, and outbound HTTPS access to www.googleapis.com (and oauth2.googleapis.com for a refresh-token grant)."
    }
  ],
  "locales": {
    "en": "locales/en.json",
    "fr": "locales/fr.json"
  },
  "ports": {
    "inputs": [
      {
        "id": 1,
        "name": "request",
        "title": "request",
        "accepts": [
          "application/json",
          "text/plain",
          "message/*"
        ],
        "multiplicity": "one",
        "required": false,
        "execution_requirement": "not_required_for_execution"
      },
      {
        "id": 2,
        "name": "file",
        "title": "file",
        "accepts": [
          "file/path",
          "text/plain",
          "application/json",
          "message/*"
        ],
        "multiplicity": "one",
        "required": false,
        "execution_requirement": "not_required_for_execution"
      }
    ],
    "outputs": [
      {
        "id": 1,
        "name": "items",
        "title": "items",
        "emits": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "many"
      },
      {
        "id": 2,
        "name": "result",
        "title": "result",
        "emits": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "many"
      },
      {
        "id": 3,
        "name": "changed",
        "title": "changed",
        "emits": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "many"
      },
      {
        "id": 4,
        "name": "error",
        "title": "error",
        "emits": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "many"
      }
    ]
  },
  "config": {
    "enabled": false,
    "api_key_ref": "",
    "secret_ref": "",
    "read_credential": "api_key",
    "operation": "search",
    "allowed_operations": [
      "search",
      "video_details",
      "channel_uploads",
      "playlist_items",
      "comments",
      "watch_uploads"
    ],
    "channel": "",
    "allow_writes": false,
    "allow_delete": false,
    "upload_root": "",
    "max_upload_bytes": 268435456,
    "default_privacy": "private",
    "default_category_id": "22",
    "made_for_kids": false,
    "notify_subscribers": false,
    "list_limit": 50,
    "page_size": 50,
    "max_pages": 5,
    "search_max_pages": 1,
    "watch_enabled": false,
    "watch_interval_sec": 900,
    "watch_max_items": 20,
    "emit_existing": false,
    "timeout_sec": 120,
    "upload_timeout_sec": 3600,
    "upload_chunk_bytes": 8388608,
    "max_request_bytes": 65536,
    "max_response_bytes": 4194304,
    "max_retries": 2,
    "max_retry_wait_sec": 20,
    "api_base_url": "https://www.googleapis.com",
    "oauth_base_url": "https://oauth2.googleapis.com",
    "ca_file": ""
  },
  "port_capabilities": {
    "can_add_inputs": false,
    "can_add_outputs": false
  },
  "runtime": {
    "initial_state": "waiting",
    "runtime_executable": true,
    "active_worker": true,
    "centralized_executor": "generic",
    "centralized_dependency_mode": "any_event",
    "active_execution_policy": "on_each_event",
    "file_browser": true
  },
  "ui_assets": {
    "modal": [
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "css",
        "path": "assets/css/settings.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      },
      {
        "kind": "js",
        "path": "assets/js/settings.js"
      },
      {
        "kind": "js",
        "path": "assets/js/block_modal.js"
      }
    ],
    "inspector_panel": [
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "css",
        "path": "assets/css/settings.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      },
      {
        "kind": "js",
        "path": "assets/js/settings.js"
      },
      {
        "kind": "js",
        "path": "assets/js/inspector_panel.js"
      }
    ],
    "node_card": [
      {
        "kind": "css",
        "path": "assets/css/node_card.css"
      }
    ]
  }
}
